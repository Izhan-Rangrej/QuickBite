# ---------- QuickBite environment ----------
# Copy to .env for local development; on Render set the same keys as
# environment variables (Dashboard → your service → Environment).

# "True"/"False" — NEVER True on a public server
QUICKBITE_DEBUG=True

# Generate one with:
#   python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
SECRET_KEY=change-me

# Comma-separated. Render example: quickbite.onrender.com
ALLOWED_HOSTS=localhost,127.0.0.1

# Public origin of the site (no trailing slash) — used for canonical/OG URLs
SITE_URL=http://localhost:8000

# PostgreSQL (Render creates this for you). Leave empty for local SQLite.
# DATABASE_URL=postgres://user:password@host:5432/dbname

# SMTP for real emails (Brevo / SendGrid / Mailgun). Empty = console backend.
# EMAIL_HOST=smtp-relay.brevo.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=you@example.com
# EMAIL_HOST_PASSWORD=smtp-key
# EMAIL_USE_TLS=True
# DEFAULT_FROM_EMAIL=QuickBite <no-reply@yourdomain.com>
# CONTACT_EMAIL=hello@yourdomain.com

# Google Analytics 4 (optional): G-XXXXXXXXXX
# GA_MEASUREMENT_ID=

# Google Search Console meta-tag verification token (optional)
# SEARCH_CONSOLE_TOKEN=

# Django Debug Toolbar (dev only): True to enable
DEBUG_TOOLBAR=False

# Force HTTPS redirects in production (Render handles TLS at the proxy)
SECURE_SSL_REDIRECT=True

# Behind a TLS-terminating proxy (Render/Heroku/Railway): True
USE_X_FORWARDED_HOST=False

LOG_LEVEL=INFO
