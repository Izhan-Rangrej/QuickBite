# ---------- QuickBite environment ----------
# Copy to .env for local development; on Render set the same keys as
# environment variables (Dashboard → your service → Environment).

# "True"/"False" — NEVER True on a public server
QUICKBITE_DEBUG=True

# Generate one with:
#   python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
SECRET_KEY=change-me

# Comma-separated. Render example: quickbite.onrender.com
ALLOWED_HOSTS=localhost,127.0.0.1

# Public origin of the site (no trailing slash) — used for canonical/OG URLs
SITE_URL=http://localhost:8000

# PostgreSQL — Neon in production (leave empty for local SQLite).
#
# Neon console → Project → Connect → copy ONE of these into Render:
#
#   direct (recommended for Render: few workers, no PgBouncer quirks)
#     postgresql://neondb_owner:PASS@ep-cool-name-123456.ap-southeast-1.aws.neon.tech/neondb?sslmode=require
#
#   pooled (use when you scale to many instances/connections; the -pooler host)
#     postgresql://neondb_owner:PASS@ep-cool-name-123456-pooler.ap-southeast-1.aws.neon.tech/neondb?sslmode=require
#
# The string must keep `?sslmode=require` — Neon refuses non-TLS connections.
# quickbite/db.py parses it (percent-decoded password, query params → OPTIONS) and
# auto-disables server-side cursors/prepared statements for `-pooler` hosts.
# DATABASE_URL=postgres://user:password@host:5432/dbname
# DB_CONN_MAX_AGE=60        # persistent connections; set 0 for transaction poolers
# DB_CONN_HEALTH_CHECKS=True  # reconnect instead of 500-ing after Neon wakes up

# SMTP for real emails (Brevo / SendGrid / Mailgun). Empty = console backend.
# EMAIL_HOST=smtp-relay.brevo.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=you@example.com
# EMAIL_HOST_PASSWORD=smtp-key
# EMAIL_USE_TLS=True
# DEFAULT_FROM_EMAIL=QuickBite <no-reply@yourdomain.com>
# CONTACT_EMAIL=hello@yourdomain.com

# Google Analytics 4 (optional): G-XXXXXXXXXX
# GA_MEASUREMENT_ID=

# Google Search Console meta-tag verification token (optional)
# SEARCH_CONSOLE_TOKEN=

# Django Debug Toolbar (dev only): True to enable
DEBUG_TOOLBAR=False

# Force HTTPS redirects in production (Render handles TLS at the proxy)
SECURE_SSL_REDIRECT=True

# Behind a TLS-terminating proxy (Render/Heroku/Railway): True
USE_X_FORWARDED_HOST=False

# CSRF origin whitelist for https POSTs. Auto-filled from SITE_URL, so you only
# need this for extra hosts (e.g. a www + apex domain, or a preview URL):
# CSRF_TRUSTED_ORIGINS=https://quickbite.com,https://www.quickbite.com

# Where uploads live. Default: <repo>/media — which on Render is EPHEMERAL unless
# you mount a persistent disk. Point it at the mount path to keep uploads:
# MEDIA_ROOT=/opt/render/project/src/media

# build.sh seeds sample data on first deploy so the site isn't empty. Flip to
# False once you have real restaurants/dishes in the database.
QUICKBITE_SEED_ON_BUILD=False

LOG_LEVEL=INFO
